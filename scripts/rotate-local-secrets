#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_ENV="$ROOT_DIR/backend/.env"
FRONTEND_ENV="$ROOT_DIR/frontend/.env"
WHATSAPP_ENV="$ROOT_DIR/whatsapp-service/.env"

for file in "$BACKEND_ENV" "$FRONTEND_ENV" "$WHATSAPP_ENV"; do
  if [[ ! -f "$file" ]]; then
    echo "File konfigurasi belum ada: $file" >&2
    echo "Salin file .env.example masing-masing sebelum merotasi secret." >&2
    exit 1
  fi
done

if ! command -v openssl >/dev/null 2>&1; then
  echo "OpenSSL diperlukan untuk membuat secret lokal." >&2
  exit 1
fi

replace_env_value() {
  local file="$1"
  local key="$2"
  local value="$3"
  local temporary
  temporary="$(mktemp)"

  awk -v target="$key" -v replacement="$value" '
    BEGIN { found = 0 }
    index($0, target "=") == 1 {
      print target "=" replacement
      found = 1
      next
    }
    { print }
    END {
      if (! found) {
        print target "=" replacement
      }
    }
  ' "$file" > "$temporary"

  chmod 600 "$temporary"
  mv "$temporary" "$file"
}

service_token="$(openssl rand -hex 32)"
webhook_secret="$(openssl rand -hex 32)"
reverb_secret="$(openssl rand -hex 32)"
reverb_key="$(awk -F= '/^REVERB_APP_KEY=/{sub(/^[^=]*=/, ""); print; exit}' "$BACKEND_ENV")"
reverb_key="${reverb_key:-orvyn-reverb-key}"

replace_env_value "$BACKEND_ENV" "WHATSAPP_SERVICE_TOKEN" "$service_token"
replace_env_value "$WHATSAPP_ENV" "WHATSAPP_SERVICE_TOKEN" "$service_token"
replace_env_value "$BACKEND_ENV" "WHATSAPP_WEBHOOK_SECRET" "$webhook_secret"
replace_env_value "$WHATSAPP_ENV" "WHATSAPP_WEBHOOK_SECRET" "$webhook_secret"
replace_env_value "$BACKEND_ENV" "REVERB_APP_SECRET" "$reverb_secret"
replace_env_value "$FRONTEND_ENV" "VITE_REVERB_APP_KEY" "$reverb_key"

echo "Secret WhatsApp dan Reverb lokal sudah dirotasi dan disinkronkan."
echo "Restart backend, Reverb, frontend, dan WhatsApp service agar nilai baru aktif."
