# Sanctum SPA cookies require the frontend and API to be same-site,
# or VITE_API_URL must point to a same-origin reverse proxy.
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=ORVYN
VITE_DEMO_LOGIN_ENABLED=false

# Public Firebase web client config. Never put a service-account key or private key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_REVERB_APP_KEY=orvyn-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=ws
# Optional override. Default: <VITE_API_URL origin>/sanctum/csrf-cookie
# VITE_CSRF_COOKIE_URL=http://localhost:8000/sanctum/csrf-cookie
# Optional override. Default: <VITE_API_URL origin>/broadcasting/auth
# VITE_BROADCAST_AUTH_ENDPOINT=http://localhost:8000/broadcasting/auth
