datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlockType {
  DEEP_WORK
  LECTURE
  SLEEP
  BREAK
  ROUTINE
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  firebaseUid  String        @unique @map("firebase_uid")
  email        String        @unique
  name         String
  preferences  Json          @default("{\"theme\": \"dark\", \"focus_hours\": [9, 21], \"sleep_duration\": 8}")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  tasks        Task[]
  timeBlocks   TimeBlock[]
  habits       Habit[]
  transactions Transaction[]
  briefings    AIBriefing[]

  @@map("users")
}

model Task {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  deadline        DateTime?
  status          TaskStatus       @default(TODO)
  priority        TaskPriority     @default(MEDIUM)
  durationMinutes Int              @default(60) @map("duration_minutes")
  difficulty      Int              @default(3)
  category        String           @default("academics")
  tags            String[]
  aiProcessed     Boolean          @default(false) @map("ai_processed")
  completedAt     DateTime?        @map("completed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  embeddings      TaskEmbedding[]
  timeBlocks      TimeBlock[]

  @@map("tasks")
}

model TaskEmbedding {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid @map("task_id")
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  embedding    Unsupported("vector(768)")
  chunkContent String   @map("chunk_content")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("task_embeddings")
}

model TimeBlock {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?   @db.Uuid @map("task_id")
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  label     String
  startTime DateTime  @map("start_time")
  endTime   DateTime  @map("end_time")
  isLocked  Boolean   @default(false) @map("is_locked")
  blockType BlockType @default(DEEP_WORK) @map("block_type")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("time_blocks")
}

model Habit {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  frequencyCron String   @map("frequency_cron")
  currentStreak Int      @default(0) @map("current_streak")
  bestStreak    Int      @default(0) @map("best_streak")
  history       Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("habits")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid @map("user_id")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  category    String
  description String
  date        DateTime
  isRecurring Boolean         @default(false) @map("is_recurring")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("transactions")
}

model AIBriefing {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @db.Uuid @map("user_id")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefingDate           DateTime @map("briefing_date") @db.Date
  summaryContent         String   @map("summary_content")
  healthMetrics          Json     @map("health_metrics")
  recommendedAdjustments Json     @map("recommended_adjustments")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("ai_briefings")
}
