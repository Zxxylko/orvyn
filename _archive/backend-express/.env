# ORVYN Backend Configuration Environment

# Server Settings
PORT=4000
NODE_ENV=development

# Database Settings (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orvyn_db?schema=public"

# Cache & Queue Settings (Redis)
REDIS_URL="redis://localhost:6379"

# AI Key Integrations (Configure your API credentials here)
GEMINI_API_KEY="your-gemini-api-key-here"
CLAUDE_API_KEY="your-claude-api-key-here"

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID="orvyn-student-os"
# FIREBASE_CREDENTIALS_JSON='{ ... }'
