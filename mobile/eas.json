{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_ORVYN_BUILD_ENV": "development",
        "EXPO_PUBLIC_DEMO_LOGIN_ENABLED": "true",
        "EXPO_PUBLIC_MANUAL_TOKEN_LOGIN_ENABLED": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "channel": "development-simulator"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ORVYN_BUILD_ENV": "preview",
        "EXPO_PUBLIC_DEMO_LOGIN_ENABLED": "true",
        "EXPO_PUBLIC_MANUAL_TOKEN_LOGIN_ENABLED": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "channel": "preview-simulator"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_ORVYN_BUILD_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
