# Simulator iOS / Expo web:
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Android emulator uses http://10.0.2.2:8000/api/v1.
# A physical device must use the Mac LAN IP, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1

# Production must use HTTPS:
# EXPO_PUBLIC_API_URL=https://api.orvyn.app/api/v1

# Local diagnostics only. These paths are forcibly disabled in production builds.
EXPO_PUBLIC_DEMO_LOGIN_ENABLED=true
EXPO_PUBLIC_MANUAL_TOKEN_LOGIN_ENABLED=true

# Public Firebase web-app configuration (safe to embed; never use a service-account key here).
# EXPO_PUBLIC_FIREBASE_API_KEY=AIza...
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
# EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# OAuth clients from the same Google/Firebase project.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-example.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789-example.apps.googleusercontent.com

# EAS production File variable containing Firebase Android configuration.
# The file must contain app.orvyn.mobile, the release signing SHA-1, and the Web OAuth client above.
# GOOGLE_SERVICES_JSON=./google-services.json
