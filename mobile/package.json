{
  "name": "@orvyn/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.6",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.10",
    "@react-navigation/native": "^7.3.10",
    "@react-navigation/native-stack": "^7.18.2",
    "axios": "^1.18.1",
    "expo": "~57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.16",
    "firebase": "12.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-nitro-google-signin": "1.0.2",
    "react-native-nitro-modules": "0.36.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "uuid": "11.1.1"
  },
  "scripts": {
    "start": "expo start",
    "start:device": "expo start --lan --go",
    "start:dev-client": "expo start --lan --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios:simulator": "npx eas-cli@latest build --platform ios --profile development-simulator",
    "build:preview": "npx eas-cli@latest build --platform all --profile preview",
    "build:production": "npx eas-cli@latest build --platform all --profile production",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin"
        ]
      }
    }
  },
  "private": true
}
