{
	admin off
	email {$ACME_EMAIL}
	log {
		output stderr
		format json
		level WARN
	}
	servers {
		protocols h1 h2 h3
	}
}

http://127.0.0.1:2019 {
	respond /health "ok" 200
	respond 404
}

{$ORVYN_DOMAIN} {
	root * /srv
	encode zstd gzip

	@backend path /api/* /sanctum/* /broadcasting/*
	handle @backend {
		reverse_proxy api:8080 {
			header_up -X-Forwarded-For
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	@reverb path /app/*
	handle @reverb {
		reverse_proxy reverb:8080 {
			header_up -X-Forwarded-For
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			flush_interval -1
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://apis.google.com https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://accounts.google.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com wss://{$ORVYN_DOMAIN}; frame-src https://accounts.google.com https://{$FIREBASE_AUTH_DOMAIN}; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	log {
		output stderr
		format json
	}
}
