# Alternate host-level package only. `postgres` is resolvable inside the
# production Compose data network, not from the VPS host. Use the Compose restic
# profile for the documented one-VPS architecture; change PGHOST here only when
# a separate, securely routed PostgreSQL endpoint intentionally exists.
# Non-secret connection settings. Do not put passwords or private keys here.
PGHOST=postgres
PGPORT=5432
PGDATABASE=orvyn
PGUSER=orvyn_backup
PGCONNECT_TIMEOUT=10

# Secret file paths. Mount these files read-only with the narrowest possible access.
PGPASSFILE=/run/secrets/postgres_pgpass
BACKUP_AGE_RECIPIENT_FILE=/run/secrets/backup_age_recipient
BACKUP_AGE_IDENTITY_FILE=/run/secrets/backup_age_identity

# Local encrypted backup storage.
BACKUP_DIR=/var/backups/orvyn
BACKUP_RETENTION_DAYS=14

# Optional offsite copy. Leave BACKUP_S3_URI empty to disable it.
# BACKUP_S3_URI=s3://orvyn-production-backups/postgres
# BACKUP_AWS_CREDENTIALS_FILE=/run/secrets/aws_credentials
# AWS_PROFILE=orvyn-backup
# AWS_DEFAULT_REGION=ap-southeast-1

# Set only for an S3-compatible provider. HTTPS is mandatory.
# BACKUP_S3_ENDPOINT_URL=https://s3.example.com

# archive = checksum, decryption, and pg_restore archive validation only.
# database = restore into a disposable database and run a health query.
RESTORE_VERIFY_MODE=archive
PGMAINTENANCE_DB=postgres
# Required only for database mode, after confirming the verifier uses disposable
# encrypted storage that will be destroyed after the drill.
# RESTORE_VERIFY_EPHEMERAL_STORAGE_ACK=YES
