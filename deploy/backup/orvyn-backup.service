[Unit]
Description=ORVYN encrypted PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=orvyn-backup
Group=orvyn-backup
UMask=0077
EnvironmentFile=/etc/orvyn/backup.env
ExecStart=/opt/orvyn/deploy/scripts/backup-postgres.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadOnlyPaths=/run/secrets
ReadWritePaths=/var/backups/orvyn

[Install]
WantedBy=multi-user.target
